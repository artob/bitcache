[0.204, "o", "\u001b[?2004l\r\r\n"]
[0.016, "o", "Bitcache is a distributed content-addressable storage (CAS) system\r\n\r\n\u001b[33mUsage:\u001b[0m \u001b[32mbitcache\u001b[0m \u001b[32m[OPTIONS]\u001b[0m \u001b[32m[COMMAND]\u001b[0m\r\n\r\n\u001b[33mGeneral commands:\u001b[39m\r\n  id     Compute the BLAKE3 hash of the given file(s)\r\n  help   Print this message or the help of the given subcommand(s)\r\n\r\n\u001b[33mCurrent repository commands (`$BITCACHE_URL`, default `./.bitcache/`):\u001b[39m\r\n  init   Initialize a new repository in `./.bitcache/`\r\n  list   List the IDs of the blobs in the repository, in ascending order\r\n  has    Check whether the repository contains blob(s) with the given ID(s)\r\n  get    Fetch blob(s) from the repository, writing their contents to stdout\r\n  put    Store the given file(s) into the repository as blob(s)\r\n  rm     Remove blob(s) with the given ID(s) from the repository\r\n  clear  Remove all blobs from the repository\r\n\r\n\u001b[33mRemote repository commands:\u001b[39m\r\n  push   Copy blobs missing from the given remote repositories to them\r\n  pull   Copy blobs missing from the current repository from the gi"]
[0.000, "o", "ven remotes\r\n  sync   Synchronize with the given remote repositories, in both directions\r\n\r\n\u001b[33mOptions:\u001b[39m:\r\n      \u001b[32m--color\u001b[0m\u001b[32m \u001b[0m\u001b[32m<COLOR>\u001b[0m  Set the color output mode [default: auto] [possible values: auto, always,\r\n                       never]\r\n  \u001b[32m-d\u001b[0m, \u001b[32m--debug\u001b[0m          Enable debugging output\r\n      \u001b[32m--license\u001b[0m        Show license information\r\n  \u001b[32m-v\u001b[0m, \u001b[32m--verbose\u001b[0m\u001b[32m...\u001b[0m     Enable verbose output (may be repeated for more verbosity)\r\n  \u001b[32m-V\u001b[0m, \u001b[32m--version\u001b[0m        Print version information\r\n  \u001b[32m-h\u001b[0m, \u001b[32m--help\u001b[0m           Print help (see more with '--help')\r\n"]
